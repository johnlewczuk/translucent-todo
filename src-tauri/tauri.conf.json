{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "translucent-todo",
  "version": "0.6.0",
  "identifier": "io.github.johnlewczuk.translucent-todo",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420/",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "translucent-todo",
        "width": 320,
        "height": 420,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "resizable": false,
        "minWidth": 120,
        "minHeight": 36,
        "shadow": false,
        "focus": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/128x128@2x.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/bin/todo": "../dist-cli/todo.mjs"
        }
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
